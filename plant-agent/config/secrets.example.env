# !! 이 파일에는 키를 넣지 말 것 (깃허브에 공개되는 양식 파일) !!
# 같은 폴더의 secrets.env에 값을 채움. secrets.env는 깃에서 제외되며 외부 공유 금지.

# NAVER API HUB (네이버 클라우드 플랫폼) — 쇼핑인사이트: 카테고리 수요·키워드 비교
NAVER_APIHUB_CLIENT_ID=
NAVER_APIHUB_CLIENT_SECRET=

# 네이버 커머스API (apicenter.commerce.naver.com) — 상품 등록용
NAVER_COMMERCE_CLIENT_ID=
